# Open Music Club 生产环境变量（逐项说明）
# 复制为 /srv/open-music-club/shared/.env，权限 600，属主 omc

# ============ 运行环境 ============
NODE_ENV=production
HOST=127.0.0.1                 # 只监听回环，公网由 Nginx 暴露
PORT=3000
PUBLIC_ORIGIN=https://music.example.com   # 必须 HTTPS，且只含协议+域名
TRUST_PROXY_HOPS=1              # 只有一层 Nginx 才是 1，多一层就要改

# ============ 会话与安全 ============
SESSION_SECRET=                 # 必填：openssl rand -base64 48
SESSION_IDLE_TIMEOUT_MINUTES=480
TOTP_ENCRYPTION_KEY=            # 必填：openssl rand -base64 32
                                # 丢失后已绑定的认证器无法解密，必须与备份分开保管

# ============ 数据存储（必须指向持久卷） ============
DATABASE_PATH=/srv/open-music-club/shared/data/open-music-club.sqlite
REDIS_URL=redis://:密码@127.0.0.1:6379
                                # 生产环境校验必须是回环地址

# ============ 超时 ============
REQUEST_TIMEOUT_MS=30000
HEADERS_TIMEOUT_MS=10000
KEEP_ALIVE_TIMEOUT_MS=5000

# ============ 首个管理员 ============
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=                 # 至少 8 位；首次登录后立即修改并开启 2FA
ADMIN_NICKNAME=管理员

# ============ 上传 ============
MAX_UPLOAD_MB=100               # 同时把 Nginx client_max_body_size 设为 110m

# ============ 邮件（可选） ============
MAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465                   # 465 隐式 TLS，其他端口强制 STARTTLS
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=club@example.com
MAIL_ADMIN_TO=admin@example.com

# ============ 阿里云邮件投递查询（可选） ============
ALIYUN_DM_ACCESS_KEY_ID=
ALIYUN_DM_ACCESS_KEY_SECRET=
ALIYUN_DM_SECURITY_TOKEN=
ALIYUN_DM_REGION_ID=cn-hangzhou
